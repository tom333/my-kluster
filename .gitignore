.vscode
secrets/

# Ansible — vault password files (jamais commiter)
**/.vault-password*
**/*.vault-password
ansible/*.retry

# Ansible — exports RouterOS (peut contenir des données sensibles, hors Git)
ansible/routeros/exports/

# Ansible — configs clients WireGuard (CONTIENNENT la clé privée du client)
ansible/routeros/wg-clients/

# Backups locaux (ex. vault.yml.bak lors d'une réencryption) — jamais commiter
**/*.bak
# Caches Python (3 .pyc avaient été committés par erreur dans scripts/eval-harness/)
__pycache__/
*.pyc
.pytest_cache/

# Transcripts de runs : gisement d'entrainement (paires contexte -> tool_call),
# archives depuis /tmp qui est ephemere. Volumineux et binaire-comme : on garde
# les fichiers sur disque, pas dans l'historique Git.
scripts/harness-bench/trajectoires/

# Poste local, jamais versionne
.kube/
*.pdf
# Contient une URL MCP avec un jeton dans le chemin (Home Assistant)
.mcp.json
