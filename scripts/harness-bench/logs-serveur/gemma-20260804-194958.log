tuiles) != 3:\\n                raise ValueError\\n            self.tuiles = tuple(tuiles)\\n        else:\\n            if not isinstance(tuiles, (list, tuple)) or len(tuiles) != 3:\\n                raise ValueError\\n            self.tuiles = tuple(tuiles)\\n\\n    def cycler(self):\\n        return Colonne((self.tuiles[2], self.tuiles[0], self.tuiles[1]))\\n\\n    def __eq__(self, autre):\\n        if isinstance(autre, Colonne):\\n            return self.tuiles == autre.tuiles\\n        return False\\n\\ndef alignements(plateau):\\n    res = set()\\n    \\n    # Horizontal\\n    for r in range(plateau.hauteur):\\n        c = 0\\n        while c < plateau.largeur:\\n            tuile = plateau.grille[r][c]\\n            if tuile is None:\\n                c += 1\\n                continue\\n            start = c\\n            while c < plateau.largeur and plateau.grille[r][c] == tuile:\\n                c += 1\\n            if c - start >= 3:\\n                for i in range(start, c):\\n                    res.add((r, i))\\n                    \\n    # Vertical\\n    for c in range(plateau.largeur):\\n        r = 0\\n        while r < plateau.hauteur:\\n            tuile = plateau.grille[r][c]\\n            if tuile is None:\\n                r += 1\\n                continue\\n            start = r\\n            while r < plateau.hauteur and plateau.grille[r][c] == tuile:\\n                r += 1\\n            if r - start >= 3:\\n                for i in range(start, r):\\n                    res.add((i, c))\\n\\n    # Diagonals Down-Right (dr=1, dc=1)\\n    for r in range(plateau.hauteur):\\n        for c in range(plateau.largeur):\\n            tuile = plateau.grille[r][c]\\n            if tuile is not None:\\n                dr, dc = 1, 1\\n                prev_r, prev_c = r - dr, c - dc\\n                if not plateau.dedans(prev_r, prev_c) or plateau.grille[prev_r][prev_c] != tuile:\\n                    count = 0\\n                    curr_r, curr_c = r