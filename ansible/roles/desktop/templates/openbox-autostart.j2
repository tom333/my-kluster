# Managed by Ansible (desktop role). Openbox session autostart.
# Solid background (pas de wallpaper lourd).
xsetroot -solid "#15151f" &
{% if desktop_screenlock | bool %}
# Verrou parental. xss-lock écoute l'ACTIVATION de l'économiseur X et lance
# i3lock : il faut donc armer l'économiseur, alors qu'un media PC le désactive
# d'ordinaire. i3lock verrouille DANS la session (ni VT ni greeter, contrairement
# à light-locker qui a enfermé l'utilisateur dehors le 2026-08-21). DPMS reste
# coupé — l'écran ne s'éteint pas (ce téléviseur supporte mal les cycles DPMS),
# il affiche le verrou.
# ⚠️ Ne PAS croire que les applications suspendent l'économiseur toutes seules.
# Ce commentaire a longtemps affirmé que mpv (Jellyfin) et SDL (jeux) le
# faisaient : c'est faux ici. Jellyfin passe par l'API D-Bus
# org.freedesktop.ScreenSaver, que personne n'implémente sous Openbox — l'appel
# échoue en silence et le verrou tombait en pleine lecture (2026-09-13).
# D'où `inhiber-verrou`, qui réarme le compteur tant qu'un son sort.
# Réserve connue : les manettes ne sont pas des périphériques X « core », donc
# naviguer longtemps dans Pegasus à la manette seule ne réarme pas le compteur.
# D'où un délai généreux plutôt que serré.
xset s {{ desktop_screenlock_timeout }} s blank -dpms &
xss-lock -- i3lock --nofork --color=101018 --ignore-empty-password --show-failed-attempts &
inhiber-verrou &
{% else %}
# Media PC : pas de mise en veille écran pendant les vidéos.
xset s off -dpms &
{% endif %}
{% if desktop_frontend == 'pegasus' %}
# Chien de garde : si plus AUCUNE fenêtre n'est affichée (application qui se
# cache sans mourir, Pegasus resté caché à l'attendre), débloque tout seul.
surveiller-ecran &
# Frontend canapé (shell), sous supervision.
# ⚠️ Le commentaire précédent annonçait ici une relance « sauf sortie propre »
# que le code n'a JAMAIS faite : c'était un simple `pegasus-fe &`. Or Pegasus est
# le SEUL affichage de cette session (ni barre, ni bureau, ni menu), donc le
# quitter laisse un écran noir dont seul SSH permet de sortir. Constaté le
# 2026-09-18 : « Closing Pegasus, goodbye! » dans lastrun.log, puis deux jours
# d'écran noir pendant lesquels `surveiller-ecran` appelait `reafficher` toutes
# les minutes en vain — `reafficher` tue les applications lancées PAR Pegasus, il
# ne peut rien quand c'est Pegasus lui-même qui manque.
# La sortie propre est donc relancée elle aussi : il n'y a rien d'autre à afficher.
# Pas de `ansible_user_dir` ici : le play tourne en `become: true`, les facts sont
# donc collectés en root et ce chemin résolvait /root/Applications -> la session
# openbox (qui tourne en {{ ansible_user }}) se prenait un "Permission denied" et
# n'affichait qu'un fond vide. 55_pegasus.yml installe bien sous /home/<user>.
while :; do
    /home/{{ ansible_user }}/Applications/pegasus/pegasus-fe || true
    # Garde-fou anti-emballement si Pegasus ne démarre plus du tout.
    sleep 3
done &
{% else %}
# Barre + launchers (Brave / Jellyfin / Lutris).
tint2 &
{% endif %}
