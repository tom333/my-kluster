# Managed by Ansible (desktop role). Openbox session autostart.
# Solid background (pas de wallpaper lourd).
xsetroot -solid "#15151f" &
{% if desktop_screenlock | bool %}
# Verrou parental. xss-lock écoute l'ACTIVATION de l'économiseur X et lance
# i3lock : il faut donc armer l'économiseur, alors qu'un media PC le désactive
# d'ordinaire. i3lock verrouille DANS la session (ni VT ni greeter, contrairement
# à light-locker qui a enfermé l'utilisateur dehors le 2026-08-21). DPMS reste
# coupé — l'écran ne s'éteint pas (ce téléviseur supporte mal les cycles DPMS),
# il affiche le verrou.
# Ce qui ne verrouille PAS pendant l'usage : SDL (jeux, RetroArch) et mpv
# (Jellyfin) suspendent l'économiseur tant qu'ils tournent.
# Réserve connue : les manettes ne sont pas des périphériques X « core », donc
# naviguer longtemps dans Pegasus à la manette seule ne réarme pas le compteur.
# D'où un délai généreux plutôt que serré.
xset s {{ desktop_screenlock_timeout }} s blank -dpms &
xss-lock -- i3lock --nofork --color=101018 --ignore-empty-password --show-failed-attempts &
{% else %}
# Media PC : pas de mise en veille écran pendant les vidéos.
xset s off -dpms &
{% endif %}
{% if desktop_frontend == 'pegasus' %}
# Frontend canapé (shell). Relance si l'utilisateur le quitte (sauf sortie propre).
# Pas de `ansible_user_dir` ici : le play tourne en `become: true`, les facts sont
# donc collectés en root et ce chemin résolvait /root/Applications -> la session
# openbox (qui tourne en {{ ansible_user }}) se prenait un "Permission denied" et
# n'affichait qu'un fond vide. 55_pegasus.yml installe bien sous /home/<user>.
/home/{{ ansible_user }}/Applications/pegasus/pegasus-fe &
{% else %}
# Barre + launchers (Brave / Jellyfin / Lutris).
tint2 &
{% endif %}
